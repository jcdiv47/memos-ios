    },
    "%lld changes haven’t uploaded yet and will be lost. This removes your memos from this iPhone. They stay on your server." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld change hasn’t uploaded yet and will be lost. This removes your memos from this iPhone. They stay on your server."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld changes haven’t uploaded yet and will be lost. This removes your memos from this iPhone. They stay on your server."
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "还有 %lld 项更改尚未上传，退出后将会丢失。这会从这台 iPhone 上移除你的 Memo，服务器上的 Memo 不受影响。"
                }
              }
            }
          }
        }
