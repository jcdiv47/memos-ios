    "That doesn’t look like a server address." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这似乎不是服务器地址。"
          }
        }
      }
    },
    "That username and password don’t match." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用户名或密码不正确。"
          }
        }
      }
    },
    "The address you open Memos at in a browser." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即你在浏览器中打开 Memos 时使用的地址。"
          }
        }
      }
    },
    "The same setting as on the web. Writing inside a Space narrows Protected and Public to the Space’s members." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与网页版中的设置相同。在空间中写的 Memo，“受保护”和“公开”会收窄为仅空间成员可见。"
