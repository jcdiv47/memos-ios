    "%@ added you to %@" : {
      "comment" : "An Inbox notification: the sender's name, then a Space's name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ added you to %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 已将你加入 %2$@"
          }
        }
      }
    },
    "%@ commented on your memo" : {
      "comment" : "An Inbox notification; the sender's name.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 评论了你的 Memo"
          }
        }
      }
    },
